  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "next dev -p 3055",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "lint:fix": "biome check --write",
    "i18n-check": "i18n-check --source en --locales messages -u src/ -f next-intl -i \"Projects.professionalProjects*\" \"Projects.personalProjects*\" \"Testimonials.cards*\" \"Articles.articles*\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.2",
