    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-plausible": "4.0.0",
    "node-mailjet": "^6.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-recaptcha": "^3.1.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@lingual/i18n-check": "^0.9.5",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
