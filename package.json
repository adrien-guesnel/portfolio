    "@storybook/react": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "daisyui": "^5.7.50",
    "husky": "^9.1.7",
    "postcss": "^8.5.30",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "browserslist": "> 1%"
