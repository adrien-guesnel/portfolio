{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 3055",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "lint:fix": "biome check --write",
    "i18n-check": "i18n-check --source en --locales messages -u src/ -f next-intl -i \"Projects.professionalProjects*\" \"Projects.personalProjects*\" \"Testimonials.cards*\" \"Articles.articles*\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.2",
    "@svgr/webpack": "^8.1.0",
    "clsx": "^2.1.1",
    "iconoir-react": "^7.12.1",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "next-plausible": "4.0.0",
    "node-mailjet": "^6.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@lingual/i18n-check": "^0.9.5",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/nextjs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-google-recaptcha": "^2.1.9",
    "daisyui": "^5.7.21",
    "husky": "^9.1.7",
    "postcss": "^8.5.26",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@>=4": "^5.0.9",
      "fast-uri@3": "^3.1.5",
      "js-yaml@4": "^4.3.1",
      "svgo@3": "^3.3.4"
