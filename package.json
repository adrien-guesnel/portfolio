    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "next-plausible": "4.0.0",
    "node-mailjet": "^6.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-google-recaptcha": "^3.1.0",
